# PostgreSQL JDBC URL used by the local backend.
# Optional; default: jdbc:postgresql://127.0.0.1:5432/campus_agent
DB_URL=jdbc:postgresql://127.0.0.1:5432/campus_agent

# PostgreSQL database name used by docker-compose.yml.
# Optional; default: campus_agent
DB_NAME=campus_agent

# Docker Compose published ports. Optional; these are the default host ports.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=80

# Spring profile used by the backend container.
# Optional; default: dev. Use prod only after externalizing the database schema and admin setup.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL username used by docker-compose.yml and the local backend.
# Optional; default: postgres
DB_USERNAME=postgres

# JWT signing secret used by the backend.
# Required in production; dev default is for local development only.
MCP_JWT_SECRET=dev-only-change-this-jwt-secret-at-least-32-bytes

# JWT expiration in milliseconds.
# Optional; default: 3600000 (1 hour)
MCP_JWT_EXPIRATION=3600000

# PostgreSQL password used by docker-compose.yml and the local backend.
# Optional; default: postgres; example: replace-with-a-local-password
DB_PASSWORD=postgres

# Internal service key used for /internal/v1/mcp/tools/calls.
# Optional for local mock development; required for production/internal calls.
# Do not commit a real key.
MCP_INTERNAL_SERVICE_KEY=

# Whether dev/profile startup requires the internal service key.
# Optional; dev default: false; example: true
MCP_INTERNAL_REQUIRE_SERVICE_KEY=false

# Tool execution mode.
# Optional; dev default: mock; example: http
MCP_EXECUTION_MODE=mock

# Connectivity check connection timeout in ISO-8601 duration format.
# Optional; default: PT2S; example: PT5S
MCP_CONNECTIVITY_CONNECT_TIMEOUT=PT2S

# Connectivity check read timeout in ISO-8601 duration format.
# Optional; default: PT5S; example: PT10S
MCP_CONNECTIVITY_READ_TIMEOUT=PT5S

# Tool execution connection timeout in ISO-8601 duration format.
# Optional; default: PT2S; example: PT5S
MCP_EXECUTION_CONNECT_TIMEOUT=PT2S

# Tool call timeout in ISO-8601 duration format.
# Optional; default: PT10S; example: PT20S
MCP_EXECUTION_CALL_TIMEOUT=PT10S

# Local Caffeine cache for Server / Tool paged queries. TTL in ISO-8601 duration, max-size in entries.
# Optional; defaults: server 5m / 1000, tool 5m / 1000.
MCP_CACHE_SERVER_TTL=5m
MCP_CACHE_SERVER_MAX_SIZE=1000
MCP_CACHE_TOOL_TTL=5m
MCP_CACHE_TOOL_MAX_SIZE=1000
